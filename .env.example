# ---------------------------------------------------------------------------
# Neo — environment
#
# Only NEO_SESSION_SECRET is strictly required. Everything else switches on an
# optional capability; Neo starts without them and shows what is missing.
# Copy to .env.local for local development, or paste into your host's env vars.
# ---------------------------------------------------------------------------

# --- Required --------------------------------------------------------------

# Signs session cookies AND encrypts the API keys accounts store, so treat it
# as the master secret. At least 32 characters.
# Generate:  openssl rand -base64 48
# Rotating it logs everyone out and invalidates every stored API key.
NEO_SESSION_SECRET=


# --- Accounts --------------------------------------------------------------

# Invite code new accounts must present. Signup is CLOSED while this is unset,
# which is the safe default. The first account created becomes the owner.
# Generate:  openssl rand -hex 12
NEO_SIGNUP_CODE=


# --- Database (needed for accounts to survive a restart) -------------------

# Without these, accounts and fleets live in memory and vanish when the process
# restarts — which on Vercel is every cold start. Apply supabase/schema.sql first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=


# --- Who pays for the model calls -----------------------------------------
#
# Default (NEO_SHARED_KEYS unset): every account brings its own API key, which
# it enters in the Account panel. Costs you nothing.
#
# NEO_SHARED_KEYS=true: accounts without a key of their own fall back to the
# keys below — you pay, so NEO_MONTHLY_TOKEN_LIMIT caps each account. An
# account's own key always wins over yours and is never capped.

NEO_SHARED_KEYS=false

# Tokens (input + output) each account may spend per calendar month on your
# keys. 0 disables the cap — do not do that on a public deployment.
NEO_MONTHLY_TOKEN_LIMIT=200000

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional fallback GitHub token. Accounts can store their own instead.
GITHUB_TOKEN=
# Optional: list this user's or organisation's repositories instead of your own.
GITHUB_OWNER=


# --- Demo -----------------------------------------------------------------

# Show four synthetic nodes to accounts with no real machine reporting yet.
# Clearly labelled as demo data in the UI.
NEO_DEMO_MODE=false
