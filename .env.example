# ---------------------------------------------------------------------------
# Neo — environment
#
# Only the first block is required. Everything else switches on an optional
# integration; Neo starts without them and shows them as OFF in the System app.
# Copy to .env.local for local development, or paste into your host's env vars.
# ---------------------------------------------------------------------------

# --- Required --------------------------------------------------------------

# The password you sign in with.
NEO_ACCESS_PASSWORD=change-me

# Signing key for the session cookie. At least 32 characters.
# Generate one:  openssl rand -base64 48
NEO_SESSION_SECRET=

# Name shown in the HUD. Cosmetic.
NEO_OPERATOR_NAME=Operator


# --- Model providers (at least one needed for chat and agents) -------------

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=


# --- GitHub ----------------------------------------------------------------

# Fine-grained personal access token with read access to the repositories you
# want to watch (Contents, Issues, Pull requests, Actions: read-only).
GITHUB_TOKEN=
# Optional: list this user's or organisation's repositories instead of your own.
GITHUB_OWNER=


# --- Device telemetry ------------------------------------------------------

# Shared secret. agent/neo_agent.py must send the same value.
# Generate one:  openssl rand -hex 32
NEO_AGENT_TOKEN=


# --- Durable storage (optional) -------------------------------------------

# Without these, Neo keeps the fleet and event log in memory and loses them
# when the process restarts. Apply supabase/schema.sql first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=


# --- Demo -----------------------------------------------------------------

# Show four synthetic nodes while no real agent is reporting. Clearly labelled
# as demo data in the UI.
NEO_DEMO_MODE=false
